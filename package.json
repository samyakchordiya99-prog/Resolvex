{
  "name": "resolvex-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace runner for ResolveX",
  "scripts": {
    "start": "npm --prefix ResolveX start",
    "dev": "npm --prefix ResolveX dev",
    "install:all": "npm --prefix ResolveX run install:all",
