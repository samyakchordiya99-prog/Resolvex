PORT=5000
# Comma-separated fallback; frontend uses VITE_API_URL
FRONTEND_ORIGIN=http://localhost:5173
DEFAULT_TIMEOUT_MS=3000
MAX_TESTS_PER_SERVER=30

# --- Optional AI explanations (AI DNS Detective) ---
